#!/usr/bin/env node
// bin/liberd-entry
const liberd = require('../src/daemon/liberd');

// Handle termination signals for clean shutdown
process.on('SIGINT', () => liberd.stop());
process.on('SIGTERM', () => liberd.stop());

// Safety net: a bug in one request must never kill the daemon silently.
process.on('uncaughtException', (err) => {
  console.error(`[liberd] uncaughtException (daemon stays up): ${err && err.message}`);
});

liberd.start().catch(err => {
  console.error(`[FATAL] Daemon crashed: ${err.message}`);
  process.exit(1);
});
