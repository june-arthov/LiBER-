{
  "applicationId": "com.liber.desktop",
  "version": "0.5.0",
  "defaultMode": "window",
  "port": 0,
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "documentRoot": "/app/",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "filesystem.readFile",
    "os.execCommand",
    "os.getEnv"
  ],
  "modes": {
    "window": {
      "title": "LiBER",
      "width": 1400,
      "height": 900,
      "minWidth": 980,
      "minHeight": 640,
      "center": true,
      "borderless": false,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "liber-desktop",
    "resourcesPath": "/app/",
    "clientLibrary": "/app/assets/neutralino.js",
    "binaryVersion": "5.6.0",
    "clientVersion": "5.6.0"
  }
}