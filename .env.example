# Liber Environment Configuration
#
# Paste ONE key below, or set it in Settings -> Providers (stored encrypted in
# .liber/, no file editing at all).
#
# Every key line is commented out on purpose. A line like
#   OLLAMA_CLOUD_API_KEY=your_key_here
# is not empty: it is sent to the provider verbatim and comes back as
# "HTTP 401: Unauthorized", which reads like a broken install instead of a
# missing key. Uncomment a line only when you have the real value.

# Ollama Cloud (https://ollama.com/v1)
#OLLAMA_CLOUD_API_KEY=

# OpenAI-compatible vendors (each uses its own key name)
#OPENAI_API_KEY=
#GROQ_API_KEY=
#DEEPSEEK_API_KEY=
#MISTRAL_API_KEY=
#OPENROUTER_API_KEY=
#XAI_API_KEY=
#TOGETHER_API_KEY=

# Dedicated adapters
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=


